# Copy to .env and fill in. See docs/architecture.md for details.

# --- Database ---
# A dedicated PostgreSQL database + role for MONO (do not use the postgres superuser).
DATABASE_URL="postgresql://mono_app:PASSWORD@localhost:5432/mono_dev?schema=public"
# Only required if the app role cannot CREATE DATABASE (needed by `prisma migrate dev`):
# SHADOW_DATABASE_URL="postgresql://mono_app:PASSWORD@localhost:5432/mono_shadow?schema=public"

# --- Auth ---
# 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
SESSION_COOKIE_NAME="mono_session"
SESSION_MAX_AGE_DAYS="30"

# --- App ---
APP_URL="http://localhost:3000"

# --- Storage abstraction ---
STORAGE_DRIVER="local"          # local (dev only) | s3 (production — see below)
STORAGE_LOCAL_ROOT="./.storage"
STORAGE_PUBLIC_PREFIX="/media"

# S3-compatible object storage (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO).
# Required only when STORAGE_DRIVER=s3. The bucket MUST be private — objects are served
# solely through the authenticated /media route, never a public URL.
S3_BUCKET=""
S3_REGION="auto"               # AWS: the real region (us-east-1 …). R2: "auto".
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                 # R2: https://<accountid>.r2.cloudflarestorage.com — blank for AWS
# S3_FORCE_PATH_STYLE="true"   # MinIO / some S3-compatibles; defaults on when S3_ENDPOINT is set

# --- Image pipeline ---
IMAGE_PROCESSOR="sharp"        # sharp (thumbnails + blur placeholders) | noop (store original as-is)

# --- Email abstraction (password recovery) ---
EMAIL_DRIVER="console"          # console | smtp
EMAIL_FROM="MONO <no-reply@mono.local>"

# --- Google OAuth (optional; enables Google sign-in) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Place discovery (optional external provider) ---
PLACE_PROVIDER="none"          # none | google
GOOGLE_PLACES_API_KEY=""

# --- Web Push (VAPID) — optional; `npm run vapid` prints a fresh pair ---
# With none set, browser/PWA push is off and in-app notifications carry everything.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""            # same as VAPID_PUBLIC_KEY (exposed to the browser)
VAPID_SUBJECT="mailto:you@example.com"     # a contact address for the push services
