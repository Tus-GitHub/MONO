{
  "name": "mono",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/check-function-size.mjs",
    "vercel-build": "prisma generate && node scripts/migrate-deploy.mjs && npm run build",
    "check:function-size": "node scripts/check-function-size.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deployment-cleanup": "node --test test/deployment-cleanup.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:first-visit": "node scripts/test-first-visit.mjs",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "vapid": "node scripts/generate-vapid.mjs",
    "postinstall": "prisma generate",
    "check:storage": "node scripts/check-storage.mjs",
    "cleanup:deployments": "node scripts/cleanup-vercel-deployments.mjs",
    "check:places": "node scripts/check-places.mjs",
    "check:email": "node scripts/check-email.mjs",
    "reminders:worker": "node scripts/reminder-worker.mjs",
    "reminders:dispatch": "node scripts/reminder-worker.mjs --once"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "chess.js": "1.4.0",
    "jose": "^5.9.6",
    "next": "16.3.4",
    "nodemailer": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "6.19.3",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
